# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL — use a dedicated application role, not the postgres superuser.
DATABASE_URL=postgresql://library_app:CHANGE_ME@localhost:5432/digital_library?schema=public
# Separate database used ONLY by integration tests (it is reset on every test run).
# The database name must contain "test".
DATABASE_URL_TEST=postgresql://library_app:CHANGE_ME@localhost:5432/digital_library_test?schema=public

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN_MINUTES=480
JWT_ISSUER=digital-library
AUTH_COOKIE_NAME=dlms_session
# Lock an account for AUTH_LOCKOUT_MINUTES after this many consecutive failed logins.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Per-IP login attempt rate limit.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Comma-separated browser origins allowed to call the API (the Angular dev server uses a proxy,
# so this mainly matters for split-origin deployments).
CORS_ORIGINS=http://localhost:4200
# Set to the number of reverse-proxy hops in production (e.g. 1 behind nginx). 0 = no proxy.
TRUST_PROXY=0

# Uploaded files (book covers). Keep outside the web root; back it up with the database.
STORAGE_DIR=storage
# Optional production setting: serve Angular build files from this directory on the same origin.
# Leave unset for local development (Angular dev server uses proxy.conf.json).
# FRONTEND_DIST_DIR=../frontend/dist/frontend/browser

# Cover OCR provider. The API key remains server-side and uploaded cover images are not retained.
OCR_PROVIDER=google-vision
GOOGLE_CLOUD_VISION_API_KEY=CHANGE_ME_GOOGLE_CLOUD_VISION_API_KEY

# Development seed only (npm run db:seed). Creates the first admin account if it does not exist.
SEED_ADMIN_EMAIL=admin@library.local
SEED_ADMIN_PASSWORD=CHANGE_ME_Strong_Password_123
SEED_ADMIN_NAME=System Administrator
