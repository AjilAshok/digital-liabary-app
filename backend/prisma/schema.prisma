// Digital Library Management System — Prisma schema
// See docs/DATABASE_DESIGN.md for the reviewed ER model and modelling decisions.
//
// Conventions
// - Tables are snake_case plural (@@map); columns are camelCase.
// - Primary keys are UUIDv7 (time-ordered) stored as native `uuid`.
// - Catalogue/master records are soft-archived with `archivedAt`; they are never hard-deleted
//   once referenced. Transactional history (loans, fines, purchases, imports, audits,
//   audit logs, copy history) is append-only/preserved: relations use Restrict.
// - Money is Decimal(12,2). Currency is a library setting (see `settings`).
// - Business invariants that need predicates use partial unique indexes (preview feature
//   `partialIndexes`); value checks the schema language cannot express are CHECK constraints
//   appended to the migration SQL (Prisma leaves CHECK constraints untouched).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  /// pg_trgm powers partial/fuzzy search (GIN trigram indexes below). It is a trusted
  /// extension (PostgreSQL 13+), so the database owner can create it without superuser rights.
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum CopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  DAMAGED
  MISSING
  UNDER_REPAIR
  DISCARDED
  PENDING_VERIFICATION
}

enum CopyCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AcquisitionType {
  LEGACY_OLD_STOCK
  PURCHASED_NEW
  DONATED
  TRANSFERRED
  OTHER
}

enum ContributorRole {
  AUTHOR
  EDITOR
  TRANSLATOR
  ILLUSTRATOR
  COMPILER
}

enum MetadataSource {
  MANUAL
  IMPORT
  GOOGLE_BOOKS
  OPEN_LIBRARY
  OCR_ASSISTED
}

enum CopyEventType {
  CREATED
  STATUS_CHANGED
  CONDITION_CHANGED
  MOVED
  DETAILS_UPDATED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  ARCHIVED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  LOST
}

enum ReservationStatus {
  PENDING
  READY_FOR_PICKUP
  FULFILLED
  CANCELLED
  EXPIRED
}

enum FineStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  WAIVED
}

enum FinePaymentKind {
  PAYMENT
  WAIVER
}

enum ScanMode {
  ISBN_BARCODE
  ACCESSION_BARCODE
  COVER_OCR
  MANUAL
}

enum ScanOutcome {
  LOCAL_MATCH
  EXTERNAL_MATCH
  NO_MATCH
  INVALID_INPUT
  ERROR
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  CONFIRMING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  EXCLUDED
  IMPORTED
  FAILED
}

enum StockAuditScope {
  LIBRARY
  BUILDING
  FLOOR
  ROOM
  RACK
  SHELF
}

enum StockAuditStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockAuditResult {
  FOUND
  MISPLACED
  UNEXPECTED
  UNKNOWN_BARCODE
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity, roles and permissions
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased and trimmed.
  email            String    @unique
  fullName         String
  passwordHash     String
  isActive         Boolean   @default(true)
  /// Incremented to invalidate all issued JWTs (logout-everywhere, password change, deactivation).
  tokenVersion     Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles            UserRole[]
  auditLogs        AuditLog[]
  scanLogs         ScanLog[]
  copyEvents       CopyHistory[]
  purchasesCreated Purchase[]
  loansIssued      Loan[]           @relation("LoanIssuedBy")
  loansReturned    Loan[]           @relation("LoanReturnedBy")
  renewals         LoanRenewal[]
  finePayments     FinePayment[]
  importBatches    ImportBatch[]
  auditsStarted    StockAudit[]     @relation("StockAuditStartedBy")
  auditsCompleted  StockAudit[]     @relation("StockAuditCompletedBy")
  auditScans       StockAuditItem[]
  editionsVerified BookEdition[]
  settingsUpdated  Setting[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable machine code, e.g. ADMIN, LIBRARIAN, ASSISTANT.
  code        String   @unique
  name        String
  description String?
  /// System roles cannot be deleted from the UI.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  /// e.g. "catalogue.write". The canonical list lives in src/security/permissions.ts.
  code        String @unique
  description String
  group       String

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Settings and number sequences
// ─────────────────────────────────────────────────────────────────────────────

/// Library-configurable policies (currency, accession format, circulation defaults...).
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("settings")
}

/// Gap-tolerant counters for generated identifiers (e.g. accession numbers).
/// Incremented with a row lock inside the transaction that creates the record.
model NumberSequence {
  key       String   @id
  prefix    String   @default("")
  nextValue Int      @default(1)
  padding   Int      @default(6)
  updatedAt DateTime @updatedAt

  @@map("number_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue: works, editions, authors, publishers, categories
// ─────────────────────────────────────────────────────────────────────────────

model Author {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Library-defined author number (e.g. Cutter number). Unique when supplied.
  authorNumber   String?   @unique
  name           String
  /// Lower-cased, whitespace-collapsed name for duplicate checks and search.
  normalizedName String
  sortName       String?
  description    String?   @map("biography")
  nationality    String?
  dateOfBirth    DateTime? @db.Date
  birthYear      Int?
  deathYear      Int?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  books BookAuthor[]

  /// Not unique: different authors can share a name — authorNumber disambiguates.
  @@index([normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "authors_normalizedName_trgm_idx")
  @@map("authors")
}

model Publisher {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  normalizedName String    @unique
  place          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  editions BookEdition[]

  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "publishers_normalizedName_trgm_idx")
  @@map("publishers")
}

model Category {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  normalizedName String    @unique
  /// Optional classification code (e.g. DDC class) — unique when supplied.
  code           String?   @unique
  parentId       String?   @db.Uuid
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  books    Book[]

  @@index([parentId])
  @@map("categories")
}

/// Bibliographic work/title. Editions (ISBN-level) hang off a Book; copies hang off an edition.
model Book {
  id               String    @id @default(uuid(7)) @db.Uuid
  title            String
  subtitle         String?
  normalizedTitle  String
  description      String?
  originalLanguage String?
  categoryId       String?   @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category Category?     @relation(fields: [categoryId], references: [id])
  authors  BookAuthor[]
  editions BookEdition[]

  @@index([normalizedTitle])
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_normalizedTitle_trgm_idx")
  @@index([categoryId])
  @@map("books")
}

model BookAuthor {
  bookId   String          @db.Uuid
  authorId String          @db.Uuid
  role     ContributorRole @default(AUTHOR)
  /// Display order of contributors.
  position Int             @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id])

  @@id([bookId, authorId, role])
  @@index([authorId])
  @@map("book_authors")
}

/// Edition/manifestation: the level an ISBN identifies.
model BookEdition {
  id               String         @id @default(uuid(7)) @db.Uuid
  bookId           String         @db.Uuid
  /// Normalized ISBN-13 digits (ISBN-10s are converted). Indexed but intentionally NOT unique:
  /// legacy data can contain shared/incorrect ISBNs; duplicates are resolved by workflow.
  isbn13           String?
  /// Original ISBN-10 when the item carries one.
  isbn10           String?
  editionStatement String?
  publisherId      String?        @db.Uuid
  publicationYear  Int?
  language         String?
  pageCount        Int?
  format           String?
  coverImageKey    String?
  metadataSource   MetadataSource @default(MANUAL)
  /// Provider id (Google Books volume id / Open Library key) when metadata came from a provider.
  externalSourceId String?
  verifiedAt       DateTime?
  verifiedById     String?        @db.Uuid
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  book          Book           @relation(fields: [bookId], references: [id])
  publisher     Publisher?     @relation(fields: [publisherId], references: [id])
  verifiedBy    User?          @relation(fields: [verifiedById], references: [id])
  copies        BookCopy[]
  purchaseItems PurchaseItem[]
  reservations  Reservation[]
  scanLogs      ScanLog[]

  @@index([bookId])
  @@index([isbn13])
  @@index([isbn10])
  @@index([publisherId])
  @@map("book_editions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Locations: Building > Floor > Room > Rack > Shelf
// ─────────────────────────────────────────────────────────────────────────────

model Building {
  id         String    @id @default(uuid(7)) @db.Uuid
  code       String    @unique
  name       String
  address    String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  floors Floor[]

  @@map("buildings")
}

model Floor {
  id         String    @id @default(uuid(7)) @db.Uuid
  buildingId String    @db.Uuid
  code       String
  name       String
  level      Int?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  building Building @relation(fields: [buildingId], references: [id])
  rooms    Room[]

  @@unique([buildingId, code])
  @@map("floors")
}

model Room {
  id         String    @id @default(uuid(7)) @db.Uuid
  floorId    String    @db.Uuid
  code       String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  floor Floor  @relation(fields: [floorId], references: [id])
  racks Rack[]

  @@unique([floorId, code])
  @@map("rooms")
}

model Rack {
  id         String    @id @default(uuid(7)) @db.Uuid
  roomId     String    @db.Uuid
  code       String
  name       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  room    Room    @relation(fields: [roomId], references: [id])
  shelves Shelf[]

  @@unique([roomId, code])
  @@map("racks")
}

model Shelf {
  id         String    @id @default(uuid(7)) @db.Uuid
  rackId     String    @db.Uuid
  code       String
  name       String?
  capacity   Int?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  rack              Rack             @relation(fields: [rackId], references: [id])
  copies            BookCopy[]
  historyMovedFrom  CopyHistory[]    @relation("CopyHistoryFromShelf")
  historyMovedTo    CopyHistory[]    @relation("CopyHistoryToShelf")
  auditExpectations StockAuditItem[] @relation("StockAuditExpectedShelf")
  auditFindings     StockAuditItem[] @relation("StockAuditFoundShelf")

  @@unique([rackId, code])
  @@map("shelves")
}

// ─────────────────────────────────────────────────────────────────────────────
// Physical copies
// ─────────────────────────────────────────────────────────────────────────────

/// One row per physical item. Stock counts are always derived from these rows.
model BookCopy {
  id               String          @id @default(uuid(7)) @db.Uuid
  /// Unique per physical item; generated from `number_sequences` or preserved from legacy registers.
  accessionNumber  String          @unique
  /// Value printed on the label. Encodes the accession number by default (never the ISBN).
  barcode          String?         @unique
  editionId        String          @db.Uuid
  acquisitionType  AcquisitionType
  acquisitionDate  DateTime?       @db.Date
  acquisitionPrice Decimal?        @db.Decimal(12, 2)
  supplierId       String?         @db.Uuid
  purchaseItemId   String?         @db.Uuid
  condition        CopyCondition   @default(GOOD)
  status           CopyStatus      @default(PENDING_VERIFICATION)
  shelfId          String?         @db.Uuid
  remarks          String?
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  edition              BookEdition      @relation(fields: [editionId], references: [id])
  supplier             Supplier?        @relation(fields: [supplierId], references: [id])
  purchaseItem         PurchaseItem?    @relation(fields: [purchaseItemId], references: [id])
  shelf                Shelf?           @relation(fields: [shelfId], references: [id])
  history              CopyHistory[]
  loans                Loan[]
  reservations         Reservation[]
  auditItems           StockAuditItem[]
  importRow            ImportRow?       @relation("ImportRowCreatedCopy")
  /// Import rows that were flagged as possible duplicates of this copy.
  importDuplicateFlags ImportRow[]      @relation("ImportRowDuplicateOf")

  /// (editionId, status) serves per-edition availability counts.
  @@index([editionId, status])
  @@index([status])
  @@index([shelfId])
  @@index([acquisitionType])
  @@index([purchaseItemId])
  @@map("book_copies")
}

/// Status/condition/location history for each copy (fulfils "ConditionHistory").
model CopyHistory {
  id            String         @id @default(uuid(7)) @db.Uuid
  copyId        String         @db.Uuid
  eventType     CopyEventType
  fromStatus    CopyStatus?
  toStatus      CopyStatus?
  fromCondition CopyCondition?
  toCondition   CopyCondition?
  fromShelfId   String?        @db.Uuid
  toShelfId     String?        @db.Uuid
  reason        String?
  changedById   String?        @db.Uuid
  createdAt     DateTime       @default(now())

  copy      BookCopy @relation(fields: [copyId], references: [id])
  changedBy User?    @relation(fields: [changedById], references: [id])
  fromShelf Shelf?   @relation("CopyHistoryFromShelf", fields: [fromShelfId], references: [id])
  toShelf   Shelf?   @relation("CopyHistoryToShelf", fields: [toShelfId], references: [id])

  @@index([copyId, createdAt])
  @@map("copy_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// Purchases
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  normalizedName String    @unique
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  purchases Purchase[]
  copies    BookCopy[]

  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(uuid(7)) @db.Uuid
  supplierId     String         @db.Uuid
  invoiceNumber  String?
  invoiceDate    DateTime?      @db.Date
  orderDate      DateTime?      @db.Date
  status         PurchaseStatus @default(DRAFT)
  subtotal       Decimal?       @db.Decimal(12, 2)
  taxTotal       Decimal?       @db.Decimal(12, 2)
  totalAmount    Decimal?       @db.Decimal(12, 2)
  invoiceFileKey String?
  notes          String?
  createdById    String         @db.Uuid
  receivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@unique([supplierId, invoiceNumber])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  purchaseId       String   @db.Uuid
  editionId        String   @db.Uuid
  quantity         Int
  receivedQuantity Int      @default(0)
  unitPrice        Decimal  @db.Decimal(12, 2)
  /// Percentage, e.g. 5.00 = 5%. Optional — taxes are library-specific.
  taxRate          Decimal? @db.Decimal(5, 2)
  discountAmount   Decimal? @db.Decimal(12, 2)
  lineTotal        Decimal  @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchase Purchase    @relation(fields: [purchaseId], references: [id])
  edition  BookEdition @relation(fields: [editionId], references: [id])
  copies   BookCopy[]

  @@index([purchaseId])
  @@index([editionId])
  @@map("purchase_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Members and circulation
// ─────────────────────────────────────────────────────────────────────────────

/// Configurable circulation policy per member category. No defaults are hard-coded in code.
model MemberType {
  id                  String   @id @default(uuid(7)) @db.Uuid
  code                String   @unique
  name                String
  maxActiveLoans      Int
  loanPeriodDays      Int
  maxRenewals         Int
  gracePeriodDays     Int      @default(0)
  finePerDay          Decimal  @db.Decimal(12, 2)
  /// Member is blocked from borrowing when unpaid fines exceed this amount (null = no block).
  maxUnpaidFines      Decimal? @db.Decimal(12, 2)
  reservationHoldDays Int
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members Member[]

  @@map("member_types")
}

model Member {
  id               String       @id @default(uuid(7)) @db.Uuid
  membershipNumber String       @unique
  memberTypeId     String       @db.Uuid
  fullName         String
  email            String?
  phone            String?
  address          String?
  status           MemberStatus @default(ACTIVE)
  joinedAt         DateTime     @default(now()) @db.Date
  expiresAt        DateTime?    @db.Date
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberType   MemberType    @relation(fields: [memberTypeId], references: [id])
  loans        Loan[]
  reservations Reservation[]
  fines        Fine[]

  @@index([fullName])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "members_fullName_trgm_idx")
  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("members")
}

model Loan {
  id              String         @id @default(uuid(7)) @db.Uuid
  copyId          String         @db.Uuid
  memberId        String         @db.Uuid
  status          LoanStatus     @default(ACTIVE)
  issuedAt        DateTime       @default(now())
  dueAt           DateTime
  returnedAt      DateTime?
  renewalCount    Int            @default(0)
  returnCondition CopyCondition?
  issuedById      String         @db.Uuid
  returnedById    String?        @db.Uuid
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  copy       BookCopy      @relation(fields: [copyId], references: [id])
  member     Member        @relation(fields: [memberId], references: [id])
  issuedBy   User          @relation("LoanIssuedBy", fields: [issuedById], references: [id])
  returnedBy User?         @relation("LoanReturnedBy", fields: [returnedById], references: [id])
  renewals   LoanRenewal[]
  fines      Fine[]

  /// At most one ACTIVE loan per copy — enforced by PostgreSQL even under concurrent issue requests.
  @@unique([copyId], map: "loans_one_active_per_copy_key", where: raw("status = 'ACTIVE'"))
  @@index([copyId])
  @@index([memberId, status])
  @@index([status, dueAt])
  @@map("loans")
}

model LoanRenewal {
  id            String   @id @default(uuid(7)) @db.Uuid
  loanId        String   @db.Uuid
  previousDueAt DateTime
  newDueAt      DateTime
  renewedById   String   @db.Uuid
  createdAt     DateTime @default(now())

  loan      Loan @relation(fields: [loanId], references: [id])
  renewedBy User @relation(fields: [renewedById], references: [id])

  @@index([loanId])
  @@map("loan_renewals")
}

/// Reservations are placed on an edition; a specific copy is assigned when it is held.
model Reservation {
  id             String            @id @default(uuid(7)) @db.Uuid
  editionId      String            @db.Uuid
  memberId       String            @db.Uuid
  status         ReservationStatus @default(PENDING)
  assignedCopyId String?           @db.Uuid
  reservedAt     DateTime          @default(now())
  readyAt        DateTime?
  expiresAt      DateTime?
  fulfilledAt    DateTime?
  cancelledAt    DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  edition      BookEdition @relation(fields: [editionId], references: [id])
  member       Member      @relation(fields: [memberId], references: [id])
  assignedCopy BookCopy?   @relation(fields: [assignedCopyId], references: [id])

  /// A member holds at most one open reservation per edition.
  @@unique([memberId, editionId], map: "reservations_one_open_per_member_edition_key", where: raw("status IN ('PENDING', 'READY_FOR_PICKUP')"))
  /// A physical copy can be held for only one reservation at a time.
  @@unique([assignedCopyId], map: "reservations_one_hold_per_copy_key", where: raw("status = 'READY_FOR_PICKUP'"))
  @@index([editionId, status, reservedAt])
  @@index([memberId, status])
  @@map("reservations")
}

model Fine {
  id         String     @id @default(uuid(7)) @db.Uuid
  memberId   String     @db.Uuid
  loanId     String?    @db.Uuid
  amount     Decimal    @db.Decimal(12, 2)
  paidAmount Decimal    @default(0) @db.Decimal(12, 2)
  reason     String
  status     FineStatus @default(UNPAID)
  assessedAt DateTime   @default(now())
  settledAt  DateTime?
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  member   Member        @relation(fields: [memberId], references: [id])
  loan     Loan?         @relation(fields: [loanId], references: [id])
  payments FinePayment[]

  @@index([memberId, status])
  @@index([loanId])
  @@map("fines")
}

/// Individual payments/waivers against a fine. `Fine.paidAmount` is the running total of PAYMENT rows,
/// maintained in the same transaction; rows here are never edited or deleted (financial history).
model FinePayment {
  id           String          @id @default(uuid(7)) @db.Uuid
  fineId       String          @db.Uuid
  kind         FinePaymentKind
  amount       Decimal         @db.Decimal(12, 2)
  /// Free text (e.g. cash, card, bank transfer) — payment methods are library-specific.
  method       String?
  reference    String?
  notes        String?
  recordedById String          @db.Uuid
  recordedAt   DateTime        @default(now())

  fine       Fine @relation(fields: [fineId], references: [id])
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([fineId])
  @@index([recordedAt])
  @@map("fine_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Scanning, imports, stock audits
// ─────────────────────────────────────────────────────────────────────────────

model ScanLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @db.Uuid
  mode           ScanMode
  rawValue       String?
  normalizedIsbn String?
  outcome        ScanOutcome
  editionId      String?     @db.Uuid
  provider       String?
  /// 0..1 where a provider/OCR engine reports confidence. Never treated as certainty.
  confidence     Float?
  details        Json?
  createdAt      DateTime    @default(now())

  user    User         @relation(fields: [userId], references: [id])
  edition BookEdition? @relation(fields: [editionId], references: [id])

  @@index([userId, createdAt])
  @@index([normalizedIsbn])
  @@map("scan_logs")
}

model ImportBatch {
  id            String            @id @default(uuid(7)) @db.Uuid
  fileName      String
  fileSizeBytes Int
  fileSha256    String
  /// Import profile name (defines mandatory columns and defaults).
  profile       String
  status        ImportBatchStatus @default(UPLOADED)
  totalRows     Int               @default(0)
  validRows     Int               @default(0)
  invalidRows   Int               @default(0)
  duplicateRows Int               @default(0)
  importedRows  Int               @default(0)
  createdById   String            @db.Uuid
  confirmedAt   DateTime?
  completedAt   DateTime?
  summary       Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy User        @relation(fields: [createdById], references: [id])
  rows      ImportRow[]

  @@index([createdAt])
  @@map("import_batches")
}

model ImportRow {
  id                String          @id @default(uuid(7)) @db.Uuid
  batchId           String          @db.Uuid
  rowNumber         Int
  rawData           Json
  normalizedData    Json?
  status            ImportRowStatus @default(PENDING)
  errors            Json?
  warnings          Json?
  duplicateOfCopyId String?         @db.Uuid
  createdCopyId     String?         @unique @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  batch           ImportBatch @relation(fields: [batchId], references: [id])
  createdCopy     BookCopy?   @relation("ImportRowCreatedCopy", fields: [createdCopyId], references: [id])
  duplicateOfCopy BookCopy?   @relation("ImportRowDuplicateOf", fields: [duplicateOfCopyId], references: [id])

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}

model StockAudit {
  id            String           @id @default(uuid(7)) @db.Uuid
  name          String
  scopeType     StockAuditScope
  /// Id of the building/floor/room/rack/shelf for the scope (null for LIBRARY).
  scopeId       String?          @db.Uuid
  status        StockAuditStatus @default(IN_PROGRESS)
  startedById   String           @db.Uuid
  startedAt     DateTime         @default(now())
  completedById String?          @db.Uuid
  completedAt   DateTime?
  notes         String?
  summary       Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  startedBy   User             @relation("StockAuditStartedBy", fields: [startedById], references: [id])
  completedBy User?            @relation("StockAuditCompletedBy", fields: [completedById], references: [id])
  items       StockAuditItem[]

  @@index([status])
  @@map("stock_audits")
}

model StockAuditItem {
  id              String           @id @default(uuid(7)) @db.Uuid
  auditId         String           @db.Uuid
  copyId          String?          @db.Uuid
  scannedValue    String
  result          StockAuditResult
  expectedShelfId String?          @db.Uuid
  foundShelfId    String?          @db.Uuid
  scannedById     String           @db.Uuid
  scannedAt       DateTime         @default(now())
  notes           String?

  audit         StockAudit @relation(fields: [auditId], references: [id])
  copy          BookCopy?  @relation(fields: [copyId], references: [id])
  scannedBy     User       @relation(fields: [scannedById], references: [id])
  expectedShelf Shelf?     @relation("StockAuditExpectedShelf", fields: [expectedShelfId], references: [id])
  foundShelf    Shelf?     @relation("StockAuditFoundShelf", fields: [foundShelfId], references: [id])

  /// A copy is counted once per audit (NULL copyIds — unknown barcodes — are not constrained).
  @@unique([auditId, copyId])
  @@index([auditId, result])
  @@map("stock_audit_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of security-sensitive, inventory and circulation actions.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
